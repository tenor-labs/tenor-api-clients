{#- Same as the stock template, except that check_* lets unknown values through:
    the API adds enum values without notice, and an older client must still parse them. -#}
from typing import Literal, cast

{{ enum.class_info.name }} = Literal{{ "%r" | format(enum.values|list|sort) }}

{{ enum.get_class_name_snake_case() | upper }}_VALUES: set[{{ enum.class_info.name }}] = { {% for v in enum.values|list|sort %}{{"%r"|format(v)}}, {% endfor %} }

def check_{{ enum.get_class_name_snake_case() }}(value: {{ enum.get_instance_type_string() | as_unembedded_code }}) -> {{ enum.class_info.name}}:
    return cast({{ enum.class_info.name }}, value)
